{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "profile": {
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "lastSeenAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "homes": {
          "$homeId": {
            "homeName": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "role": { ".validate": "newData.val() == 'OWNER' || newData.val() == 'MEMBER'" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && root.child('homes').child(newData.child('homeId').val()).child('members').child(auth.uid).child('role').val() == 'OWNER') || (!newData.exists() && root.child('homes').child(data.child('homeId').val()).child('members').child(auth.uid).child('role').val() == 'OWNER'))",
        "homeId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "homeName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "createdBy": { ".validate": "newData.val() == auth.uid" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "expiresAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "homeIndex": {
      "$homeId": {
        ".write": "auth != null && (root.child('homes').child($homeId).child('members').child(auth.uid).child('role').val() == 'OWNER' || (!data.exists() && !root.child('homes').child($homeId).child('members').exists()))",
        ".validate": "newData.isBoolean() && newData.val() == true"
      }
    },

    "homes": {
      "$homeId": {
        ".read": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",

        "meta": {
          ".write": "auth != null && ((!root.child('homes').child($homeId).child('members').exists() && newData.child('ownerUid').val() == auth.uid) || root.child('homes').child($homeId).child('members').child(auth.uid).child('role').val() == 'OWNER')",
          "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "ownerUid": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "workerLastSeen": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "members": {
          "$uid": {
            ".write": "auth != null && (root.child('homes').child($homeId).child('members').child(auth.uid).child('role').val() == 'OWNER' || (auth.uid == $uid && !newData.exists()) || (auth.uid == $uid && !data.exists() && !root.child('homes').child($homeId).child('members').exists()) || (auth.uid == $uid && !data.exists() && newData.child('role').val() == 'MEMBER' && newData.child('viaCode').exists() && root.child('invites').child(newData.child('viaCode').val()).child('homeId').val() == $homeId && root.child('invites').child(newData.child('viaCode').val()).child('expiresAt').val() > now))",
            "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "role": { ".validate": "newData.val() == 'OWNER' || newData.val() == 'MEMBER'" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "viaCode": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "$other": { ".validate": false }
          }
        },

        "floors": {
          ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
          "$floorId": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "level": { ".validate": "newData.isNumber()" },
            "planAsset": { ".validate": "newData.isString()" },
            "gridCols": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16" },
            "gridRows": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16" },
            "$other": { ".validate": false }
          }
        },

        "devices": {
          ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
          "$deviceId": {
            "floorId": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "gridX": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 32" },
            "gridY": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 32" },
            "kind": { ".validate": "newData.val() == 'OUTLET' || newData.val() == 'MULTI_SWITCH' || newData.val() == 'CAMERA'" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "link": { ".validate": "(newData.val() == 'ONLINE' || newData.val() == 'DISCONNECTED') && ((!data.exists() && newData.val() == 'DISCONNECTED') || newData.val() == data.val())" },
            "camera": {
              "snapshotUrl": { ".validate": "newData.isString()" },
              "streamUrl": { ".validate": "newData.isString()" },
              "lastFrameAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "slots": {
              "$slotId": {
                "label": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "appliance": {
                  "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  "hazardous": { ".validate": "newData.isBoolean()" },
                  "watts": { ".validate": "newData.isNumber()" },
                  "$other": { ".validate": false }
                },
                "desiredState": { ".validate": "newData.isBoolean()" },
                "reportedState": { ".validate": "newData.isBoolean()" },
                "status": { ".validate": "(newData.val() == 'ON' || newData.val() == 'OFF' || newData.val() == 'ERROR' || newData.val() == 'DISCONNECTED') && ((!data.exists() && newData.val() == 'DISCONNECTED') || newData.val() == data.val())" },
                "onSince": { ".validate": "newData.isNumber() && newData.val() == data.val()" },
                "mismatchSince": { ".validate": "newData.isNumber() && newData.val() == data.val()" },
                "safety": {
                  ".validate": "root.child('homes').child($homeId).child('members').child(auth.uid).child('role').val() == 'OWNER' || newData.child('autoCutoffEnabled').val() == false",
                  "max_on_duration": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400" },
                  "autoCutoffEnabled": { ".validate": "newData.isBoolean()" },
                  "$other": { ".validate": false }
                },
                "schedule": {
                  "enabled": { ".validate": "newData.isBoolean()" },
                  "onAtMinuteOfDay": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
                  "offAtMinuteOfDay": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
                  "days": {
                    "$index": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" }
                  },
                  "$other": { ".validate": false }
                },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },

        "usage": {
          "$deviceId": {
            "$slotId": {
              "$eventId": {
                ".write": "auth != null && !data.exists() && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
                ".validate": "newData.hasChildren(['at', 'event', 'source'])",
                "at": { ".validate": "newData.isNumber()" },
                "event": { ".validate": "newData.val() == 'ON' || newData.val() == 'OFF' || newData.val() == 'CUTOFF' || newData.val() == 'ERROR' || newData.val() == 'RECONNECT'" },
                "durationSec": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "source": { ".validate": "newData.val() == 'APP' || newData.val() == 'SIMULATOR' || newData.val() == 'WORKER' || newData.val() == 'SCHEDULE'" },
                "$other": { ".validate": false }
              }
            }
          }
        },

        "alerts": {
          "$alertId": {
            ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists() && data.exists() && newData.exists() && newData.child('message').val() == data.child('message').val() && newData.child('at').val() == data.child('at').val() && newData.child('severity').val() == data.child('severity').val()",
            "acknowledged": { ".validate": "newData.isBoolean()" }
          }
        }
      }
    }
  }
}
