{
  "//": [
    "HomeSense Realtime Database security rules.",
    "",
    "Two separate guarantees are enforced here.",
    "",
    "1. TENANCY. A household is readable and writable only by its members.",
    "   Membership is recorded at homes/$homeId/members/$uid and is what every",
    "   rule below consults. A member is admitted either by creating the",
    "   household, or by presenting an unexpired invite code, which the rule",
    "   verifies against /invites rather than trusting the client.",
    "",
    "2. STATE SEPARATION. No client may publish `status`. In Realtime Database",
    "   a `.write` grant cascades to every descendant and cannot be revoked",
    "   further down, so a deeper `.write: false` would do nothing. What CAN",
    "   restrict a client is `.validate`, and the Admin SDK bypasses validation",
    "   entirely. That asymmetry is the mechanism: `status`, `link`, `onSince`",
    "   and `mismatchSince` carry validators that pass only when the value is",
    "   unchanged, so the worker writes them freely and no client can.",
    "",
    "   The same technique restricts safety configuration to the household",
    "   owner, since altering max_on_duration changes the protection applied to",
    "   everyone in the house.",
    "",
    "Honest limitation: the application and the simulator authenticate as the",
    "same kind of client, so the rules cannot tell them apart, and a modified",
    "client could write `reportedState` as though it were hardware. What no",
    "client can do is publish a status, clear an ERROR, or silence a",
    "DISCONNECTED. Separating those roles would require custom claims."
  ],

  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",

        "profile": {
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "lastSeenAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "homes": {
          "$homeId": {
            "homeName": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "role": { ".validate": "newData.val() == 'OWNER' || newData.val() == 'MEMBER'" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "invites": {
      "//": [
        "There is no .read at this level, so the collection cannot be listed.",
        "A code is readable only when its exact key is already known, which is",
        "what redemption does."
      ],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('homes').child(newData.child('homeId').val()).child('members').child(auth.uid).child('role').val() == 'OWNER' || (!newData.exists() && root.child('homes').child(data.child('homeId').val()).child('members').child(auth.uid).child('role').val() == 'OWNER'))",
        "homeId": { ".validate": "newData.isString()" },
        "homeName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "createdBy": { ".validate": "newData.val() == auth.uid" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "expiresAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "homeIndex": {
      "//": "Lets the worker discover households without reading their contents.",
      "$homeId": {
        ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
        ".validate": "newData.isBoolean()"
      }
    },

    "homes": {
      "$homeId": {
        ".read": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",

        "meta": {
          ".write": "auth != null && (!data.exists() && newData.child('ownerUid').val() == auth.uid || root.child('homes').child($homeId).child('members').child(auth.uid).child('role').val() == 'OWNER')",
          "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "ownerUid": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "workerLastSeen": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "members": {
          "$uid": {
            "//": [
              "Three admissible cases: the owner manages anyone; a member",
              "removes themselves; or a newcomer admits themselves by",
              "presenting an unexpired invite that names this household. The",
              "invite is checked against /invites, so the client cannot simply",
              "assert that it holds one."
            ],
            ".write": "auth != null && (root.child('homes').child($homeId).child('members').child(auth.uid).child('role').val() == 'OWNER' || (auth.uid == $uid && !newData.exists()) || (auth.uid == $uid && !data.exists() && !root.child('homes').child($homeId).child('meta').exists()) || (auth.uid == $uid && !data.exists() && newData.child('role').val() == 'MEMBER' && root.child('invites').child(newData.child('viaCode').val()).child('homeId').val() == $homeId && root.child('invites').child(newData.child('viaCode').val()).child('expiresAt').val() > now))",

            "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "role": { ".validate": "newData.val() == 'OWNER' || newData.val() == 'MEMBER'" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "viaCode": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "$other": { ".validate": false }
          }
        },

        "floors": {
          ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
          "$floorId": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "level": { ".validate": "newData.isNumber()" },
            "planAsset": { ".validate": "newData.isString()" },
            "gridCols": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16" },
            "gridRows": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16" },
            "$other": { ".validate": false }
          }
        },

        "devices": {
          "$deviceId": {
            "//": [
              "Adding, removing and repositioning a device is the owner's",
              "responsibility. Members are granted narrower writes below:",
              "operating a slot, editing its label and its schedule, and",
              "reporting hardware state. Because a .write grant only ever adds",
              "permission, the two compose without the wider grant weakening",
              "the narrower one."
            ],
            ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).child('role').val() == 'OWNER'",

            "floorId": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "gridX": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 16" },
            "gridY": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 16" },
            "kind": {
              ".validate": "newData.val() == 'OUTLET' || newData.val() == 'MULTI_SWITCH' || newData.val() == 'CAMERA'"
            },

            "lastSeen": {
              ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
              ".validate": "newData.isNumber()"
            },

            "link": {
              ".validate": "(newData.val() == 'ONLINE' || newData.val() == 'DISCONNECTED') && ((!data.exists() && newData.val() == 'DISCONNECTED') || newData.val() == data.val())"
            },

            "camera": {
              "snapshotUrl": { ".validate": "newData.isString()" },
              "streamUrl": { ".validate": "newData.isString()" },
              "lastFrameAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },

            "slots": {
              "$slotId": {
                "label": {
                  ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
                  ".validate": "newData.isString() && newData.val().length <= 60"
                },

                "appliance": {
                  ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
                  "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  "hazardous": { ".validate": "newData.isBoolean()" },
                  "watts": { ".validate": "newData.isNumber() || newData.val() == null" },
                  "$other": { ".validate": false }
                },

                "desiredState": {
                  ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
                  ".validate": "newData.isBoolean()"
                },

                "reportedState": {
                  ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
                  ".validate": "newData.isBoolean()"
                },

                "status": {
                  ".validate": "(newData.val() == 'ON' || newData.val() == 'OFF' || newData.val() == 'ERROR' || newData.val() == 'DISCONNECTED') && ((!data.exists() && newData.val() == 'DISCONNECTED') || newData.val() == data.val())"
                },

                "onSince": {
                  ".validate": "(newData.isNumber() || newData.val() == null) && newData.val() == data.val()"
                },
                "mismatchSince": {
                  ".validate": "(newData.isNumber() || newData.val() == null) && newData.val() == data.val()"
                },

                "safety": {
                  "//": [
                    "Owner only. Enforced with .validate rather than .write,",
                    "because the owner's .write on the device above cascades",
                    "here and could not be revoked by a narrower .write."
                  ],
                  ".validate": "root.child('homes').child($homeId).child('members').child(auth.uid).child('role').val() == 'OWNER'",
                  "max_on_duration": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
                  },
                  "autoCutoffEnabled": { ".validate": "newData.isBoolean()" },
                  "$other": { ".validate": false }
                },

                "schedule": {
                  ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
                  "enabled": { ".validate": "newData.isBoolean()" },
                  "onAtMinuteOfDay": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440"
                  },
                  "offAtMinuteOfDay": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440"
                  },
                  "days": {
                    "$index": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" }
                  },
                  "$other": { ".validate": false }
                },

                "$other": { ".validate": false }
              }
            },

            "$other": { ".validate": false }
          }
        },

        "usage": {
          "$deviceId": {
            "$slotId": {
              "$eventId": {
                "//": "Append-only: an existing event can never be rewritten.",
                ".write": "auth != null && !data.exists() && root.child('homes').child($homeId).child('members').child(auth.uid).exists()",
                "at": { ".validate": "newData.isNumber()" },
                "event": {
                  ".validate": "newData.val() == 'ON' || newData.val() == 'OFF' || newData.val() == 'CUTOFF' || newData.val() == 'ERROR' || newData.val() == 'RECONNECT'"
                },
                "durationSec": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "source": {
                  ".validate": "newData.val() == 'APP' || newData.val() == 'SIMULATOR' || newData.val() == 'WORKER' || newData.val() == 'SCHEDULE'"
                },
                ".validate": "newData.hasChildren(['at', 'event', 'source'])",
                "$other": { ".validate": false }
              }
            }
          }
        },

        "alerts": {
          "$alertId": {
            "//": [
              "Alerts are raised by the worker. A member may set acknowledged",
              "and nothing else: the message, timestamp and severity must be",
              "carried through unchanged, so an alert cannot be rewritten or",
              "invented from a phone."
            ],
            ".write": "auth != null && root.child('homes').child($homeId).child('members').child(auth.uid).exists() && data.exists() && newData.exists() && newData.child('message').val() == data.child('message').val() && newData.child('at').val() == data.child('at').val() && newData.child('severity').val() == data.child('severity').val()",
            "acknowledged": { ".validate": "newData.isBoolean()" }
          }
        }
      }
    }
  }
}
