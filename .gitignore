### Secrets — never commit these. Templates are provided instead. ###
google-services.json
# Exception: the demo flavour's file is a placeholder for a variant that never
# contacts Firebase. It exists so the google-services plugin has a package name
# to match, and it holds no credential. See the comment inside it.
!app/src/demo/google-services.json
serviceAccountKey.json
worker/serviceAccountKey.json
worker/.env
simulator/firebase-config.js
*.keystore
*.jks
keystore.properties
local.properties

### Android / Gradle ###
*.iml
.gradle/
/local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild
.cxx
release/
*.apk
*.aab
*.ap_
*.dex

# The submitted builds in apk/ are a deliverable and are committed
# deliberately, so that the repository itself carries the application.
# Build output elsewhere remains excluded by the rule above.
!apk/*.apk

