# Copy to `keystore.properties` (gitignored) to build a signed release.
#
# The keystore file itself is also gitignored. For a coursework submission the
# credentials below are shared within the team out of band; for anything real
# they would live in a secret manager and the keystore would never leave it.
#
# Generate one with:
#   keytool -genkeypair -v -keystore homesense-release.keystore \
#           -alias homesense -keyalg RSA -keysize 2048 -validity 10000

storeFile=homesense-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=homesense
keyPassword=YOUR_KEY_PASSWORD
