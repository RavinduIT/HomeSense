# Copy to `.env` (gitignored) and fill in.

# Realtime Database URL, from the Firebase console.
DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app

# Must match the app and the simulator. The live flavour uses home-1.
HOME_ID=home-1

# Minutes east of UTC used when evaluating schedules.
# Sri Lanka is UTC+5:30 = 330. The worker may run in another timezone from the
# house, so this is explicit rather than taken from the host clock.
TIMEZONE_OFFSET_MINUTES=330

# Optional. By default the worker reads ./serviceAccountKey.json.
# SERVICE_ACCOUNT_PATH=/etc/secrets/serviceAccountKey.json

# Optional, for hosts that only provide environment variables (Render, Railway):
# paste the whole service-account JSON on one line.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
