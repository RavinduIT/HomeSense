# Worker configuration.

DATABASE_URL=https://smarthome-aa2f0-default-rtdb.firebaseio.com

# Minutes east of UTC used when evaluating schedules. Sri Lanka is UTC+5:30.
# The worker may run in a different timezone from the house, so this is stated
# rather than taken from the host clock.
TIMEZONE_OFFSET_MINUTES=330

# The worker discovers households from /homeIndex and attaches to each, so no
# household identifier is required here. It is read only by the seeding
# script, which needs a single target.
HOME_ID=home-1786875277
