<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The visible theme is Material 3, declared in Compose (ui/theme/Theme.kt).
      This XML theme only covers the window before the first frame is composed,
      so it is deliberately minimal.
    -->
    <style name="Theme.HomeSense" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
